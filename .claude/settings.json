{
  "permissions": {
    "_주석처리_defaultMode": "bypassPermissions",
    "_주석처리_skipDangerousModePermissionPrompt": true,
    "allow": [
      "Edit",
      "Write",
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(python *)",
      "Bash(uv *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(~/.local/bin/uv *)",
      "Bash(\"/c/Users/User/AppData/Local/uv/bin/uv.exe\" *)",
      "Bash(pip *)",
      "Bash(ls *)",
      "Bash(where *)",
      "Bash(which *)",
      "Bash(command *)",
      "Bash(powershell.exe *)",
      "Bash(powershell *)"
    ]
  },
  "_주석처리_hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format"
          }
        ]
      }
    ]
  }
}