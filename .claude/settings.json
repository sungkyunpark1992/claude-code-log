{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(cd *)",
      "Bash(git *)",
      "Bash(python *)",
      "Bash(uv *)",
      "Bash(pip *)",
      "Bash(ls *)",
      "Bash(where *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format"
          }
        ]
      }
    ]
  }
}