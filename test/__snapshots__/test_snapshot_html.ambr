      <div class='message assistant d-2 d-11' data-message-id='d-14' id='msg-d-14'>
          <div class='header'>
              <span>🤖 Assistant <span class="model-badge">claude-3-sonnet-20240229</span></span>
              <div class='header-info'>
                  <div class='timestamp-row'>
                      <span class='timestamp' data-timestamp='2025-07-03T16:08:07.874907Z'>2025-07-03 16:08:07</span>
